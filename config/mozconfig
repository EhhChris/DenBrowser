# mozconfig — DenBrowser build configuration
# Place this file at the root of the Firefox source before building,
# or set MOZCONFIG env var pointing to this file.
#
# Usage: cp config/mozconfig <firefox-src>/.mozconfig
#        OR: export MOZCONFIG=/path/to/DenBrowser/config/mozconfig

# ── Application variables ──────────────────────────────────────────────────────
export MOZ_APP_NAME=denbrowser
export MOZ_APP_DISPLAYNAME="DenBrowser"
export SCCACHE_CACHE_SIZE="50G"

# ── Compiler (cross-platform) ─────────────────────────────────────────────────
# Firefox on Windows requires clang-cl (MSVC-compatibility mode).
# On Linux/macOS plain clang is used directly.
case "$(uname -s)" in
    MSYS*|MINGW*|CYGWIN*)
        export CC=clang-cl
        export CXX=clang-cl
        ;;
    *)
        export CC=~/.mozbuild/clang/bin/clang
        export CXX=~/.mozbuild/clang/bin/clang++
        ;;
esac

# Custom branding — text files created by patch 009, binary icons copied by build.sh
ac_add_options --with-branding=browser/branding/denbrowser

# ── Build type ────────────────────────────────────────────────────────────────
ac_add_options --enable-optimize="-O2"
ac_add_options --disable-debug
ac_add_options --enable-strip                 # [dev-reversed] → removed (debug symbols preserved)
ac_add_options --enable-install-strip         # [dev-reversed] → removed (debug symbols preserved)
ac_add_options --with-compiler-wrapper=sccache

# ── Security hardening ────────────────────────────────────────────────────────
ac_add_options --enable-hardening

# ── Disabled features ─────────────────────────────
# Flags marked [dev-reversed] are removed/overridden by build.sh when --dev is passed.
ac_add_options --disable-crashreporter        # [dev-reversed] → --enable-crashreporter
ac_add_options --disable-updater
ac_add_options --disable-tests
ac_add_options --disable-parental-controls
ac_add_options --disable-profiling            # [dev-reversed] → --enable-profiling
ac_add_options --disable-accessibility
ac_add_options --disable-printing             # Firefox 153+: compile out native printing and print UI

# ── macOS-specific ────────────────────────────────────────────────────────────
# Uncomment and set SDK path for your Xcode version:
# ac_add_options --with-macos-sdk=/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk


# ── Parallel builds ────────────────────────────────────────────────────────────
_den_jobs() {
  case "$(uname -s)" in
    Darwin)  sysctl -n hw.logicalcpu 2>/dev/null ;;
    Linux)   nproc 2>/dev/null ;;
    MINGW*|MSYS*|CYGWIN*)  echo "${NUMBER_OF_PROCESSORS:-4}" ;;
  esac
}
_den_j="$(_den_jobs)"
: "${_den_j:=4}"   # fallback to 4 if detection fails
mk_add_options MOZ_MAKE_FLAGS="-j${_den_j}"
unset _den_jobs _den_j

# ── Build artifacts ───────────────────────────────────────────────────────────
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/../denbrowser-obj
