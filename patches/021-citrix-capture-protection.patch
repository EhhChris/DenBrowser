+constexpr DWORD kFirstAttemptWaitMs = 5000;
+constexpr DWORD kShutdownJoinTimeoutMs = 5000;
+constexpr DWORD kRenewIntervalMs = 5000;
+constexpr DWORD kRetryIntervalMs = 250;
+constexpr ULONG kAckTimeoutMs = 1500;
+constexpr uint64_t kLeaseSafetyMarginMs = 2000;
+constexpr uint64_t kAttemptSchedulingMarginMs = 250;
+constexpr uint64_t kLeaseStateNoLease = 0;
+constexpr uint64_t kLeaseStateStopping = 1;
+constexpr uint64_t kLeaseStateFailing = 2;
+
+bool IsLeaseDeadline(uint64_t aState) {
+  return aState > kLeaseStateFailing;
+}
+
+[[noreturn]] void TerminateCurrentProcessNow(DWORD aExitCode) {
+  (void)::TerminateProcess(::GetCurrentProcess(), aExitCode);
+  // TerminateProcess should not return for the current process. Retain a
+  // non-returning fail-fast fallback so no failed API call can continue in an
+  // unprotected or partially destroyed state.
+  __fastfail(FAST_FAIL_FATAL_APP_EXIT);
+}
+
+using WFVirtualChannelOpenFn = HANDLE(WINAPI*)(HANDLE, DWORD, LPSTR);
+using WFVirtualChannelCloseFn = BOOL(WINAPI*)(HANDLE);
+using WFVirtualChannelReadFn = BOOL(WINAPI*)(HANDLE, ULONG, PCHAR, ULONG,
+                                             PULONG);
+using WFVirtualChannelWriteFn = BOOL(WINAPI*)(HANDLE, PCHAR, ULONG, PULONG);
+using WFGetActiveProtocolFn = INT(WINAPI*)(DWORD);
+
+bool IsAbsoluteLocalPath(const std::wstring& aPath) {
+  return aPath.size() >= 3 &&
+         ((aPath[0] >= L'A' && aPath[0] <= L'Z') ||
+          (aPath[0] >= L'a' && aPath[0] <= L'z')) &&
+         aPath[1] == L':' && (aPath[2] == L'\\' || aPath[2] == L'/');
+}
+
+bool ReadMachineRegistryString(const wchar_t* aSubkey,
+                               const wchar_t* aValueName, REGSAM aView,
+                               std::wstring* aValue) {
+  HKEY key = nullptr;
+  if (::RegOpenKeyExW(HKEY_LOCAL_MACHINE, aSubkey, 0,
+                      KEY_QUERY_VALUE | aView, &key) != ERROR_SUCCESS) {
+    return false;
+  }
+
+  constexpr DWORD kStringTypes = RRF_RT_REG_SZ | RRF_RT_REG_EXPAND_SZ;
+  DWORD bytes = 0;
+  LSTATUS status =
+      ::RegGetValueW(key, nullptr, aValueName, kStringTypes, nullptr, nullptr,
+                     &bytes);
+  if (status != ERROR_SUCCESS || bytes < sizeof(wchar_t)) {
+    ::RegCloseKey(key);
+    return false;
+  }
+
+  aValue->resize(bytes / sizeof(wchar_t));
+  status = ::RegGetValueW(key, nullptr, aValueName, kStringTypes, nullptr,
+                          aValue->data(), &bytes);
+  ::RegCloseKey(key);
+  if (status != ERROR_SUCCESS) {
+    aValue->clear();
+    return false;
+  }
+
+  while (!aValue->empty() && aValue->back() == L'\0') {
+    aValue->pop_back();
+  }
+  return IsAbsoluteLocalPath(*aValue);
+}
+
+struct WfApi {
+  HMODULE module = nullptr;
+  WFVirtualChannelOpenFn open = nullptr;
+  WFVirtualChannelCloseFn close = nullptr;
+  WFVirtualChannelReadFn read = nullptr;
+  WFVirtualChannelWriteFn write = nullptr;
+  WFGetActiveProtocolFn getActiveProtocol = nullptr;
+
+  ~WfApi() {
+    if (module) {
+      ::FreeLibrary(module);
+    }
+  }
+
+  bool ResolveExports() {
+    open = reinterpret_cast<WFVirtualChannelOpenFn>(
+        ::GetProcAddress(module, "WFVirtualChannelOpen"));
+    close = reinterpret_cast<WFVirtualChannelCloseFn>(
+        ::GetProcAddress(module, "WFVirtualChannelClose"));
+    read = reinterpret_cast<WFVirtualChannelReadFn>(
+        ::GetProcAddress(module, "WFVirtualChannelRead"));
+    write = reinterpret_cast<WFVirtualChannelWriteFn>(
+        ::GetProcAddress(module, "WFVirtualChannelWrite"));
+    getActiveProtocol = reinterpret_cast<WFGetActiveProtocolFn>(
+        ::GetProcAddress(module, "WFGetActiveProtocol"));
+    if (open && close && read && write) {
+      return true;
+    }
+
+    ::FreeLibrary(module);
+    module = nullptr;
+    open = nullptr;
+    close = nullptr;
+    read = nullptr;
+    write = nullptr;
+    getActiveProtocol = nullptr;
+    return false;
+  }
+
+  bool LoadFromDirectory(std::wstring aDirectory) {
+    if (!IsAbsoluteLocalPath(aDirectory)) {
+      return false;
+    }
+    if (aDirectory.back() != L'\\' && aDirectory.back() != L'/') {
+      aDirectory.push_back(L'\\');
+    }
+#ifdef _WIN64
+    constexpr wchar_t kDllName[] = L"wfapi64.dll";
+#else
+    constexpr wchar_t kDllName[] = L"wfapi.dll";
+#endif
+    aDirectory.append(kDllName);
+    module = ::LoadLibraryExW(
+        aDirectory.c_str(), nullptr,
+        LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_SYSTEM32);
+    return module && ResolveExports();
+  }
+
+  bool Load() {
+    // Modern VDAs publish their HDX binary directory in these machine-wide
+    // values. Query both registry views because DenBrowser and the installed
+    // VDA are not required to have the same architecture.
+    struct RegistryLocation {
+      const wchar_t* subkey;
+      const wchar_t* value;
+    };
+    constexpr std::array<RegistryLocation, 2> kCitrixLocations{{
+        {L"SOFTWARE\\Citrix\\Install\\HDX", L"BinFolder"},
+        {L"SOFTWARE\\Citrix\\Install", L"Location"},
+    }};
+    constexpr std::array<REGSAM, 2> kRegistryViews{
+        KEY_WOW64_64KEY, KEY_WOW64_32KEY};
+
+    for (const auto view : kRegistryViews) {
+      for (const auto& location : kCitrixLocations) {
+        std::wstring directory;
+        if (ReadMachineRegistryString(location.subkey, location.value, view,
+                                      &directory) &&
+            LoadFromDirectory(directory)) {
+          return true;
+        }
+      }
+    }
+
+    // Older single-session and multi-session VDAs predate the HDX registry
+    // value. Derive their well-known Citrix subdirectories from machine-wide
+    // Program Files values instead of trusting the process environment.
+    constexpr wchar_t kWindowsLocation[] =
+        L"SOFTWARE\\Microsoft\\Windows\\CurrentVersion";
+    constexpr std::array<const wchar_t*, 2> kProgramFilesValues{
+        L"ProgramFilesDir", L"ProgramFilesDir (x86)"};
+    constexpr std::array<const wchar_t*, 3> kCitrixSubdirectories{
+        L"Citrix\\HDX\\bin", L"Citrix\\ICAService", L"Citrix\\System32"};
+
+    for (const auto view : kRegistryViews) {
+      for (const auto* value : kProgramFilesValues) {
+        std::wstring programFiles;
+        if (!ReadMachineRegistryString(kWindowsLocation, value, view,
+                                       &programFiles)) {
+          continue;
+        }
+        for (const auto* subdirectory : kCitrixSubdirectories) {
+          std::wstring directory = programFiles;
+          if (directory.back() != L'\\' && directory.back() != L'/') {
+            directory.push_back(L'\\');
+          }
+          directory.append(subdirectory);
+          if (LoadFromDirectory(directory)) {
+            return true;
+          }
+        }
+      }
+    }
+
+    // Retain a System32 fallback for VDA releases that install WFAPI there.
+#ifdef _WIN64
+    constexpr wchar_t kDllName[] = L"wfapi64.dll";
+#else
+    constexpr wchar_t kDllName[] = L"wfapi.dll";
+#endif
+    module = ::LoadLibraryExW(kDllName, nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
+    return module && ResolveExports();
+  }
+};
+
+enum class ExchangeResult {
+  kReply,
+  kNoReply,
+  kChannelFailure,
+  kProtocolFailure,
+};
+
+bool ReplyConfirmsProtection(const dencap::Message& aReply);
+
+ExchangeResult SendMessageAndReadReply(
+    const WfApi& aApi, HANDLE aChannel, dencap::MessageType aType,
+    const uint8_t (&aInstanceId)[16], uint64_t aSequence,
+    uint64_t aAttemptDeadlineMs, dencap::Message* aReply) {
+  dencap::Message message = {};
+  message.magic = dencap::kMagic;
+  message.version = dencap::kProtocolVersion;
+  message.size = sizeof(dencap::Message);
+  message.type = static_cast<uint16_t>(aType);
+  std::memcpy(message.lease_id, aInstanceId, sizeof(message.lease_id));
+  message.sequence = aSequence;
+  if (aType != dencap::MessageType::kRelease) {
+    message.lease_ms = dencap::kDefaultLeaseMs;
+  }
+
+  ULONG bytesWritten = 0;
+  if (!aApi.write(aChannel, reinterpret_cast<PCHAR>(&message), sizeof(message),
+                  &bytesWritten) ||
+      bytesWritten != sizeof(message)) {
+    return ExchangeResult::kChannelFailure;
+  }
+  if (aType == dencap::MessageType::kRelease && aReply == nullptr) {
+    return ExchangeResult::kReply;
+  }
+
+  dencap::Message bestOlderReply = {};
+  bool haveOlderPositiveReply = false;
+
+  for (;;) {
+    const uint64_t now = ::GetTickCount64();
+    if (now >= aAttemptDeadlineMs) {
+      if (haveOlderPositiveReply && aReply) {
+        *aReply = bestOlderReply;
+        return ExchangeResult::kReply;
+      }
+      return ExchangeResult::kNoReply;
+    }
+
+    dencap::Message reply = {};
+    const ULONG timeout = static_cast<ULONG>(
+        std::min<uint64_t>(aAttemptDeadlineMs - now, MAXDWORD));
+    ULONG bytesRead = 0;
+    ::SetLastError(ERROR_SUCCESS);
+    if (!aApi.read(aChannel, timeout, reinterpret_cast<PCHAR>(&reply),
+                   sizeof(reply), &bytesRead)) {
+      const DWORD error = ::GetLastError();
+      const bool timedOut =
+          error == ERROR_SUCCESS || error == ERROR_TIMEOUT ||
+          error == ERROR_SEM_TIMEOUT || error == WAIT_TIMEOUT;
+      if (timedOut && haveOlderPositiveReply && aReply) {
+        *aReply = bestOlderReply;
+        return ExchangeResult::kReply;
+      }
+      return timedOut ? ExchangeResult::kNoReply
+                      : ExchangeResult::kChannelFailure;
+    }
+    if (bytesRead != sizeof(reply)) {
+      // Citrix static-channel reads are packet-oriented. A short/oversized
+      // status is not appended to a later packet; reopen to re-establish frame
+      // alignment while the previous verified lease remains active.
+      return ExchangeResult::kChannelFailure;
+    }
+
+    if (reply.magic != dencap::kMagic ||
+        reply.version != dencap::kProtocolVersion ||
+        reply.size != sizeof(reply) ||
+        reply.type != static_cast<uint16_t>(dencap::MessageType::kStatus) ||
+        reply.flags != dencap::kResponseFlag ||
+        !dencap::LeaseIdsEqual(reply.lease_id, aInstanceId) ||
+        reply.sequence == 0 || reply.reserved != 0 ||
+        reply.sequence > aSequence) {
+      return ExchangeResult::kProtocolFailure;
+    }
+
+    if (reply.sequence == aSequence) {
+      if (aReply) {
+        *aReply = reply;
+      }
+      return ExchangeResult::kReply;
+    }
+
+    // Drain queued older statuses until the current sequence arrives. Any
+    // negative status is returned immediately; otherwise retain the newest
+    // older positive as a conservative fallback if the current ACK times out.
+    if (!ReplyConfirmsProtection(reply)) {
+      if (aReply) {
+        *aReply = reply;
+      }
+      return ExchangeResult::kReply;
+    }
+    if (!haveOlderPositiveReply ||
+        reply.sequence > bestOlderReply.sequence) {
+      bestOlderReply = reply;
+      haveOlderPositiveReply = true;
+    }
+  }
+}
+
+bool ReplyConfirmsProtection(const dencap::Message& aReply) {
+  return aReply.status == static_cast<uint32_t>(dencap::Status::kOk) &&
+         aReply.win32_error == ERROR_SUCCESS &&
+         aReply.observed_affinity == WDA_EXCLUDEFROMCAPTURE &&
+         aReply.lease_ms == dencap::kDefaultLeaseMs;
+}
+
+}  // namespace
+
+DenCitrixCaptureProtection::DenCitrixCaptureProtection() {
+  const uint64_t first = RandomUint64OrDie();
+  const uint64_t second = RandomUint64OrDie();
+  std::memcpy(mInstanceId, &first, sizeof(first));
+  std::memcpy(mInstanceId + sizeof(first), &second, sizeof(second));
+}
+
+DenCitrixCaptureProtection::~DenCitrixCaptureProtection() {
+  uint64_t state = mLeaseState.load(std::memory_order_acquire);
+  while (state != kLeaseStateStopping && state != kLeaseStateFailing &&
+         !mLeaseState.compare_exchange_weak(
+             state, kLeaseStateStopping, std::memory_order_acq_rel,
+             std::memory_order_acquire)) {
+  }
+  if (mStopEvent) {
+    ::SetEvent(mStopEvent);
+  }
+  if (mLeaseChangedEvent) {
+    ::SetEvent(mLeaseChangedEvent);
+  }
+  if (mThread) {
+    // Best-effort cancellation prevents a conforming synchronous WFAPI call
+    // from delaying shutdown. Never destroy this guard while its worker can
+    // still reference it: if cancellation does not complete promptly, the
+    // already-closing process is terminated instead of hanging indefinitely.
+    (void)::CancelSynchronousIo(mThread);
+    if (::WaitForSingleObject(mThread, kShutdownJoinTimeoutMs) !=
+        WAIT_OBJECT_0) {
+      TerminateCurrentProcessNow(ERROR_TIMEOUT);
+    }
+    ::CloseHandle(mThread);
+  }
+  if (mWatchdogThread) {
+    ::WaitForSingleObject(mWatchdogThread, INFINITE);
+    ::CloseHandle(mWatchdogThread);
+  }
+  if (mLeaseChangedEvent) {
+    ::CloseHandle(mLeaseChangedEvent);
+  }
+  if (mReadyEvent) {
+    ::CloseHandle(mReadyEvent);
+  }
+  if (mStopEvent) {
+    ::CloseHandle(mStopEvent);
+  }
+}
+
+bool DenCitrixCaptureProtection::Start() {
+  if (mThread) {
+    return mFirstAcquireSucceeded;
+  }
+
+  mStopEvent = ::CreateEventW(nullptr, TRUE, FALSE, nullptr);
+  mReadyEvent = ::CreateEventW(nullptr, TRUE, FALSE, nullptr);
+  mLeaseChangedEvent = ::CreateEventW(nullptr, FALSE, FALSE, nullptr);
+  if (!mStopEvent || !mReadyEvent || !mLeaseChangedEvent) {
+    return false;
+  }
+
+  mWatchdogThread =
+      ::CreateThread(nullptr, 0, WatchdogThreadEntry, this, 0, nullptr);
+  if (!mWatchdogThread) {
+    return false;
+  }
+
+  mThread = ::CreateThread(nullptr, 0, ThreadEntry, this, 0, nullptr);
+  if (!mThread) {
+    ::SetEvent(mStopEvent);
+    return false;
+  }
+
+  // The first acquisition happens before XRE_mainRun creates browser UI. A
+  // finite upper bound keeps a broken endpoint from hanging ICA startup.
+  ::WaitForSingleObject(mReadyEvent, kFirstAttemptWaitMs);
+  return mFirstAcquireSucceeded;
+}
+
+bool DenCitrixCaptureProtection::IsCurrentSessionIca() {
+  LPWSTR buffer = nullptr;
+  DWORD bytes = 0;
+  if (::WTSQuerySessionInformationW(WTS_CURRENT_SERVER_HANDLE,
+                                    WTS_CURRENT_SESSION, WTSClientProtocolType,
+                                    &buffer, &bytes) &&
+      buffer && bytes >= sizeof(USHORT)) {
+    const USHORT protocol = *reinterpret_cast<const USHORT*>(buffer);
+    ::WTSFreeMemory(buffer);
+    if (protocol == WTS_PROTOCOL_TYPE_ICA) {
+      return true;
+    }
+    if (protocol == WTS_PROTOCOL_TYPE_RDP) {
+      return false;
+    }
+  } else if (buffer) {
+    ::WTSFreeMemory(buffer);
+  }
+
+  // Workstation VDAs can present an ICA desktop as the Windows console
+  // session. WFGetActiveProtocol is the VDA-aware discriminator supplied by
+  // WFAPI; use it when WTS reports console or cannot classify the session.
+  WfApi api;
+  return api.Load() && api.getActiveProtocol &&
+         api.getActiveProtocol(0xFFFFFFFFu) == WTS_PROTOCOL_TYPE_ICA;
+}
+
+DWORD WINAPI DenCitrixCaptureProtection::ThreadEntry(void* aContext) {
+  static_cast<DenCitrixCaptureProtection*>(aContext)->Run();
+  return 0;
+}
+
+DWORD WINAPI DenCitrixCaptureProtection::WatchdogThreadEntry(void* aContext) {
+  static_cast<DenCitrixCaptureProtection*>(aContext)->RunWatchdog();
+  return 0;
+}
+
+void DenCitrixCaptureProtection::FailClosed() {
+  uint64_t state = mLeaseState.load(std::memory_order_acquire);
+  while (state != kLeaseStateStopping && state != kLeaseStateFailing) {
+    if (mLeaseState.compare_exchange_weak(
+            state, kLeaseStateFailing, std::memory_order_acq_rel,
+            std::memory_order_acquire)) {
+      TerminateCurrentProcessNow(ERROR_ACCESS_DENIED);
+    }
+  }
+}
+
+bool DenCitrixCaptureProtection::PublishVerifiedDeadline(
+    uint64_t aDeadlineMs) {
+  uint64_t state = mLeaseState.load(std::memory_order_acquire);
+  while (state != kLeaseStateStopping && state != kLeaseStateFailing) {
+    if (IsLeaseDeadline(state) && state >= aDeadlineMs) {
+      return true;
+    }
+    if (mLeaseState.compare_exchange_weak(
+            state, aDeadlineMs, std::memory_order_acq_rel,
+            std::memory_order_acquire)) {
+      ::SetEvent(mLeaseChangedEvent);
+      return true;
+    }
+  }
+  return false;
+}
+
+void DenCitrixCaptureProtection::RunWatchdog() {
+  HANDLE events[] = {mStopEvent, mLeaseChangedEvent};
+
+  for (;;) {
+    if (::WaitForSingleObject(mStopEvent, 0) == WAIT_OBJECT_0) {
+      return;
+    }
+
+    const uint64_t state = mLeaseState.load(std::memory_order_acquire);
+    if (state == kLeaseStateStopping || state == kLeaseStateFailing) {
+      return;
+    }
+    if (state == kLeaseStateNoLease) {
+      const DWORD result =
+          ::WaitForMultipleObjects(2, events, FALSE, INFINITE);
+      if (result == WAIT_OBJECT_0) {
+        return;
+      }
+      if (result != WAIT_OBJECT_0 + 1) {
+        FailClosed();
+        return;
+      }
+      continue;
+    }
+
+    const uint64_t deadline = state;
+    const uint64_t failClosedAt =
+        deadline > kLeaseSafetyMarginMs ? deadline - kLeaseSafetyMarginMs : 0;
+    const uint64_t now = ::GetTickCount64();
+    if (now >= failClosedAt) {
+      uint64_t expected = deadline;
+      if (mLeaseState.compare_exchange_strong(
+              expected, kLeaseStateFailing, std::memory_order_acq_rel,
+              std::memory_order_acquire)) {
+        TerminateCurrentProcessNow(ERROR_ACCESS_DENIED);
+      }
+      continue;
+    }
+
+    const DWORD waitMs = static_cast<DWORD>(
+        std::min<uint64_t>(failClosedAt - now, MAXDWORD - 1));
+    const DWORD result =
+        ::WaitForMultipleObjects(2, events, FALSE, waitMs);
+    if (result == WAIT_OBJECT_0) {
+      return;
+    }
+    if (result != WAIT_OBJECT_0 + 1 && result != WAIT_TIMEOUT) {
+      FailClosed();
+      return;
+    }
+  }
+}
+
+void DenCitrixCaptureProtection::Run() {
+  bool firstAttemptComplete = false;
+  const auto completeFirstAttempt = [&](bool aSucceeded) {
+    if (!firstAttemptComplete) {
+      mFirstAcquireSucceeded.store(aSucceeded, std::memory_order_release);
+      firstAttemptComplete = true;
+      ::SetEvent(mReadyEvent);
+    }
+  };
+
+  WfApi api;
+  if (!api.Load()) {
+    completeFirstAttempt(false);
+    return;
+  }
+
+  HANDLE channel = nullptr;
+  uint64_t sequence = 0;
+  uint64_t lastVerifiedSequence = 0;
+  bool hasVerifiedLease = false;
+  bool recovering = false;
+  uint64_t nextAttemptAt = 0;
+  struct AttemptRecord {
+    uint64_t sequence = 0;
+    uint64_t started = 0;
+  };
+  std::array<AttemptRecord, 128> attempts = {};
+  const auto rememberAttempt = [&](uint64_t aSequence, uint64_t aStarted) {
+    attempts[static_cast<size_t>(aSequence % attempts.size())] =
+        AttemptRecord{aSequence, aStarted};
+  };
+  const auto findAttemptStart = [&](uint64_t aSequence,
+                                    uint64_t* aStarted) {
+    const AttemptRecord& attempt =
+        attempts[static_cast<size_t>(aSequence % attempts.size())];
+    if (attempt.sequence != aSequence) {
+      return false;
+    }
+    *aStarted = attempt.started;
+    return true;
+  };
+
+  while (::WaitForSingleObject(mStopEvent, 0) != WAIT_OBJECT_0) {
+    if (hasVerifiedLease) {
+      const uint64_t deadline =
+          mLeaseState.load(std::memory_order_acquire);
+      if (!IsLeaseDeadline(deadline)) {
+        if (deadline == kLeaseStateStopping) {
+          break;
+        }
+        FailClosed();
+        return;
+      }
+      constexpr uint64_t kAttemptGuardMs =
+          kLeaseSafetyMarginMs + kAckTimeoutMs +
+          kAttemptSchedulingMarginMs;
+      const uint64_t latestAttemptAt =
+          deadline > kAttemptGuardMs ? deadline - kAttemptGuardMs : 0;
+      uint64_t now = ::GetTickCount64();
+      if (now > latestAttemptAt) {
+        FailClosed();
+        return;
+      }
+
+      const uint64_t target =
+          std::min<uint64_t>(nextAttemptAt, latestAttemptAt);
+      const DWORD waitMs = target > now
+                               ? static_cast<DWORD>(std::min<uint64_t>(
+                                     target - now, MAXDWORD - 1))
+                               : 0;
+      const DWORD waitResult =
+          ::WaitForSingleObject(mStopEvent, waitMs);
+      if (waitResult == WAIT_OBJECT_0) {
+        break;
+      }
+      if (waitResult != WAIT_TIMEOUT) {
+        FailClosed();
+        return;
+      }
+
+      now = ::GetTickCount64();
+      if (now > latestAttemptAt) {
+        FailClosed();
+        return;
+      }
+    }
+
+    if (!channel) {
+      // WF_CURRENT_SERVER_HANDLE is NULL and WF_CURRENT_SESSION is -1.
+      channel =
+          api.open(nullptr, 0xFFFFFFFFu,
+                   const_cast<LPSTR>(dencap::kWfApiChannelName));
+      if (!channel) {
+        if (!hasVerifiedLease) {
+          completeFirstAttempt(false);
+          return;
+        }
+        recovering = true;
+        nextAttemptAt = ::GetTickCount64() + kRetryIntervalMs;
+        continue;
+      }
+    }
+
+    const dencap::MessageType messageType =
+        hasVerifiedLease && !recovering ? dencap::MessageType::kRenew
+                                       : dencap::MessageType::kAcquire;
+    const uint64_t attemptStarted = ::GetTickCount64();
+    if (hasVerifiedLease) {
+      const uint64_t deadline =
+          mLeaseState.load(std::memory_order_acquire);
+      if (!IsLeaseDeadline(deadline)) {
+        if (deadline == kLeaseStateStopping) {
+          break;
+        }
+        FailClosed();
+        return;
+      }
+      constexpr uint64_t kAttemptGuardMs =
+          kLeaseSafetyMarginMs + kAckTimeoutMs +
+          kAttemptSchedulingMarginMs;
+      if (deadline <= kAttemptGuardMs ||
+          attemptStarted > deadline - kAttemptGuardMs) {
+        FailClosed();
+        return;
+      }
+    }
+
+    dencap::Message reply = {};
+    const uint64_t requestSequence = ++sequence;
+    rememberAttempt(requestSequence, attemptStarted);
+    const ExchangeResult exchange = SendMessageAndReadReply(
+        api, channel, messageType, mInstanceId, requestSequence,
+        attemptStarted + kAckTimeoutMs, &reply);
+
+    if (exchange == ExchangeResult::kReply) {
+      uint64_t acknowledgedAttemptStarted = 0;
+      const bool knownAttempt =
+          findAttemptStart(reply.sequence, &acknowledgedAttemptStarted);
+      if (!knownAttempt || !ReplyConfirmsProtection(reply)) {
+        if (!hasVerifiedLease) {
+          api.close(channel);
+          channel = nullptr;
+          completeFirstAttempt(false);
+          return;
+        }
+        // The endpoint has explicitly reported that current protection cannot
+        // be trusted. Do not risk blocking in channel cleanup before exiting.
+        FailClosed();
+        return;
+      }
+
+      const uint64_t candidateDeadline =
+          acknowledgedAttemptStarted + reply.lease_ms;
+      if (reply.sequence <= lastVerifiedSequence ||
+          ::GetTickCount64() >=
+              candidateDeadline - kLeaseSafetyMarginMs) {
+        if (!hasVerifiedLease) {
+          api.close(channel);
+          channel = nullptr;
+          completeFirstAttempt(false);
+          return;
+        }
+        // A duplicate or excessively delayed positive status is harmless but
+        // cannot extend the trusted deadline. The current request is already
+        // in flight, so continue recovery and consume its fresh status.
+        recovering = true;
+        nextAttemptAt = ::GetTickCount64() + kRetryIntervalMs;
+        continue;
+      }
+
+      if (!PublishVerifiedDeadline(candidateDeadline)) {
+        if (mLeaseState.load(std::memory_order_acquire) ==
+            kLeaseStateStopping) {
+          break;
+        }
+        return;
+      }
+      lastVerifiedSequence = reply.sequence;
+      hasVerifiedLease = true;
+      recovering = reply.sequence != requestSequence;
+      completeFirstAttempt(true);
+      nextAttemptAt =
+          recovering ? ::GetTickCount64() + kRetryIntervalMs
+                     : acknowledgedAttemptStarted + kRenewIntervalMs;
+      continue;
+    }
+
+    if (!hasVerifiedLease) {
+      api.close(channel);
+      channel = nullptr;
+      completeFirstAttempt(false);
+      return;
+    }
+    if (exchange == ExchangeResult::kProtocolFailure) {
+      // A malformed or explicit older negative status is not a transport
+      // hiccup. Fail before any potentially blocking channel cleanup.
+      FailClosed();
+      return;
+    }
+
+    if (exchange == ExchangeResult::kChannelFailure) {
+      api.close(channel);
+      channel = nullptr;
+    }
+
+    // A missing response does not prove that the endpoint stopped protecting
+    // the window: the request or its ACK may have been delayed/lost while the
+    // last verified lease remains active. ACQUIRE the same UUID with a fresh
+    // sequence until the watchdog's conservative deadline. Keep a
+    // packet-aligned channel after a pure timeout so a delayed positive status
+    // can still refresh the deadline; reopen after framing/write failures.
+    recovering = true;
+    nextAttemptAt = ::GetTickCount64() + kRetryIntervalMs;
+  }
+
+  completeFirstAttempt(false);
+
+  if (channel && hasVerifiedLease) {
+    const uint64_t attemptStarted = ::GetTickCount64();
+    (void)SendMessageAndReadReply(api, channel,
+                                  dencap::MessageType::kRelease, mInstanceId,
+                                  ++sequence,
+                                  attemptStarted + kAckTimeoutMs, nullptr);
+  }
+  if (channel) {
+    api.close(channel);
+  }
+}
+
+}  // namespace mozilla::denbrowser
