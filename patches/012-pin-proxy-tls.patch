+    MOZ_LOG(gPIPNSSLog, LogLevel::Error,
+            ("[%p] DenBrowser proxy pin failed; aborting handshake\n", fd));
+    PR_SetError(SSL_ERROR_BAD_CERTIFICATE, 0);
