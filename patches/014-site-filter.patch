# PATCH: 014-site-filter
#
# PURPOSE: Compile-time site whitelist and blacklist for all HTTP/HTTPS loads.
#
# THREAT MODEL ADDRESSED:
#
#   In some deployments, DenBrowser should only allow navigation to a known set
#   of approved web properties (whitelist mode), or should block specific
#   destinations known to be out-of-scope (blacklist mode).  Both lists are
#   baked into the binary at compile time so no runtime configuration, policy
#   file, or profile change can alter them.
#
# SEMANTICS:
#
#   - Only http:// and https:// URLs are filtered.  Browser-internal URIs
#     (about:, chrome:, resource:, moz-extension:, data:, blob:, etc.) are
#     never blocked by this patch, as they are required for the browser UI to
#     function.
#
#   - Hostname matching is suffix-based:
#       "example.com" matches example.com, foo.example.com, bar.foo.example.com
#       It does NOT match notexample.com.
#
#   - WHITELIST MODE (site_whitelist non-empty):
#       Only listed hosts (and their subdomains) may be loaded.
#       All other http/https requests return NS_ERROR_BLOCKED_BY_POLICY.
#
#   - BLACKLIST MODE (site_whitelist empty, site_blacklist non-empty):
#       Listed hosts are blocked; all other http/https navigations proceed.
#
#   - If both lists are empty (default), no filtering is applied.
#
# CONFIGURATION:
#
#   Add entries to config/site-config.json and rebuild.  build.sh injects
#   the arrays between the sentinel markers before compiling.
#
# HOOK POINTS:
#
#   nsDocShell::InternalLoad (docshell/base/nsDocShell.cpp)
#   Preserves the immediate, user-visible error page for top-level navigation.
#
#   nsHttpChannel::AsyncOpen (netwerk/protocol/http/nsHttpChannel.cpp)
#   Authoritative enforcement for every HTTP/HTTPS channel before upload
#   normalization, cache lookup, service-worker interception, or network I/O.
#   This covers fetch/XHR, subresources, beacons, WebSocket handshakes,
#   redirects, and other callers that never pass through docshell.
#
# USER-VISIBLE BLOCK MESSAGE:
#
#   Returning NS_ERROR_BLOCKED_BY_POLICY (not NS_ERROR_CONTENT_BLOCKED) routes
#   the failure through nsDocShell::FilterStatusForErrorPage, which renders the
#   "Blocked Page" neterror page.  The body text is the localized
#   `blockedByPolicy` string from appstrings.properties.  Two locale files are
#   patched so the user sees a DenBrowser-specific message instead of the
#   generic Firefox enterprise wording:
#     - browser/locales/en-US/chrome/overrides/appstrings.properties  (override
#       that takes precedence in DenBrowser browser builds)
#     - dom/locales/en-US/chrome/appstrings.properties                 (source
#       string; patched for consistency)
#   Both are set to: "This site is not on the DenBrowser allow-list. Contact
#   your administrator for access."

diff --git a/docshell/base/nsDocShell.cpp b/docshell/base/nsDocShell.cpp
--- a/docshell/base/nsDocShell.cpp
+++ b/docshell/base/nsDocShell.cpp
@@ -5,6 +5,8 @@
  * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
 
 #include "nsDocShell.h"
+
+#include "DenBrowserSiteFilter.h"
 
 #include <algorithm>
 #include "mozilla/dom/HTMLFormElement.h"
@@ -9330,6 +9332,21 @@
 
   MOZ_TRY(CheckDisallowedJavascriptLoad(aLoadState));
 
+  // DenBrowser: apply compile-time site filter.  Return NS_ERROR_BLOCKED_BY_POLICY
+  // so docshell maps it to the "Blocked Page" neterror (the message string is
+  // overridden in appstrings.properties below).  Call DisplayLoadError directly
+  // because InternalLoad returns BEFORE opening a channel — without an explicit
+  // call, no channel reaches OnStop and the error page never renders; the tab
+  // just sits on the previous content.
+  if (!denbrowser::SiteAllowed(aLoadState->URI())) {
+    MOZ_LOG(gDocShellLeakLog, LogLevel::Warning,
+            ("DOCSHELL %p blocked navigation to %s by DenBrowser site filter\n",
+             this, aLoadState->URI()->GetSpecOrDefault().get()));
+    DisplayLoadError(NS_ERROR_BLOCKED_BY_POLICY, aLoadState->URI(), nullptr,
+                     nullptr);
+    return NS_ERROR_BLOCKED_BY_POLICY;
+  }
+
   // If we don't have a target, we're loading into ourselves, and our load
   // delegate may want to intercept that load.
   SameDocumentNavigationState sameDocumentNavigationState;
diff --git a/netwerk/base/DenBrowserSiteFilter.h b/netwerk/base/DenBrowserSiteFilter.h
new file mode 100644
--- /dev/null
+++ b/netwerk/base/DenBrowserSiteFilter.h
@@ -0,0 +1,64 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+#ifndef DenBrowserSiteFilter_h__
+#define DenBrowserSiteFilter_h__
+
+#include <cstddef>
+
+#include "nsIURI.h"
+#include "nsString.h"
+
+namespace denbrowser {
+
+// Compile-time whitelist/blacklist. build.sh injects entries from
+// site-config.json between the sentinel markers at build time.
+//
+// Whitelist takes priority. With no whitelist, blacklist entries are denied.
+// Both empty means no filtering.
+// ── DEN: SITE_WHITELIST ──
+static const char* const kDenSiteWhitelist[] = {nullptr};
+// ── DEN END: SITE_WHITELIST ──
+// ── DEN: SITE_BLACKLIST ──
+static const char* const kDenSiteBlacklist[] = {nullptr};
+// ── DEN END: SITE_BLACKLIST ──
+
+inline bool SiteHostMatches(const nsACString& aHost, const char* aPattern) {
+  nsDependentCString pattern(aPattern);
+  if (aHost.Equals(pattern)) return true;
+  if (aHost.Length() > pattern.Length() + 1) {
+    return aHost.CharAt(aHost.Length() - pattern.Length() - 1) == '.' &&
+           Substring(aHost, aHost.Length() - pattern.Length()).Equals(pattern);
+  }
+  return false;
+}
+
+inline bool SiteAllowed(nsIURI* aURI) {
+  if (!aURI) return false;
+
+  nsAutoCString scheme;
+  if (NS_FAILED(aURI->GetScheme(scheme))) return false;
+  if (!scheme.EqualsLiteral("http") && !scheme.EqualsLiteral("https")) {
+    return true;
+  }
+
+  nsAutoCString host;
+  if (NS_FAILED(aURI->GetAsciiHost(host)) || host.IsEmpty()) return false;
+
+  if (kDenSiteWhitelist[0]) {
+    for (size_t i = 0; kDenSiteWhitelist[i]; ++i) {
+      if (SiteHostMatches(host, kDenSiteWhitelist[i])) return true;
+    }
+    return false;
+  }
+
+  for (size_t i = 0; kDenSiteBlacklist[i]; ++i) {
+    if (SiteHostMatches(host, kDenSiteBlacklist[i])) return false;
+  }
+  return true;
+}
+
+}  // namespace denbrowser
+
+#endif  // DenBrowserSiteFilter_h__
diff --git a/netwerk/base/moz.build b/netwerk/base/moz.build
--- a/netwerk/base/moz.build
+++ b/netwerk/base/moz.build
@@ -131,6 +131,7 @@
 
 EXPORTS += [
     "DenBrowserAttest.h",
