--- a/services/fxaccounts/FxAccounts.sys.mjs
+++ b/services/fxaccounts/FxAccounts.sys.mjs
@@ -59,12 +59,8 @@ ChromeUtils.defineLazyGetter(lazy, "ensureMPUnlocked", () => {
