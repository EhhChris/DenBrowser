# PATCH: 020-about-dialog
#
# Rebrands the About dialog (Help > About / macOS app menu) for DenBrowser and
# stamps it with the DenBrowser commit the build was produced from.
#
# browser/base/content/aboutDialog.xhtml:
#   - Replaces the Mozilla community ("designed by Mozilla ...") and contribute
#     ("Make a donation / get involved") blurbs with a single DenBrowser
#     description stating DenBrowser is built on Mozilla Firefox and distributed
#     under the same Mozilla Public License, linking to the DenBrowser GitHub
#     repository.
#   - Swaps contributeDesc (that block is removed) for denbrowserBuild in
#     aria-describedby, so the dialog description reads version, build id,
#     distribution, DenBrowser blurb, trademark.
#   - Adds a denbrowserBuild label immediately after the version label so the
#     build id renders to the right of "153.0esr (64-bit)". It goes into both
#     copies of the version hbox (upstream duplicates it around #ifdef
#     MOZ_UPDATER; only one survives the preprocessor, so the id stays unique).
#   - Adds a cold-face credit (U+1F976) in the bottom-right corner whose tooltip
#     reads "DenBrowser developed by Chill".
#
# browser/base/content/aboutDialog.js:
#   - Adds the DEN: BUILD_COMMIT sentinel block holding DEN_BUILD_COMMIT, which
#     build.sh (Step 2.8) rewrites with `git rev-parse --short HEAD` of the
#     DenBrowser repo, suffixed "-dirty" when that tree had uncommitted changes.
#     The hash identifies the patch set and config a binary came from — the
#     Firefox source arrives as a versioned tarball with no history of its own.
#   - init() localizes denbrowserBuild with that hash, and hides the label when
#     the constant is empty (build.sh found no git checkout to read).
#
# browser/base/content/aboutDialog.css:
#   - Styles denbrowserBuild dimmer than the bold version string next to it, and
#     keeps it text-selectable like #version so the id can be copied for support.
#
# browser/branding/denbrowser/locales/en-US/brand.ftl:
#   - Adds about-denbrowser-description and about-denbrowser-build. The
#     github-link label is overlaid onto the <label data-l10n-name="github-link">
#     element in aboutDialog.xhtml, which supplies the href. brand.ftl is already
#     loaded by the dialog (rel="localization" href="branding/brand.ftl"), so no
#     new wiring is needed.
#
# Depends on 009 (creates brand.ftl). The Licensing Information bottom link
# (about:license) is intentionally left in place.


diff --git a/browser/base/content/aboutDialog.css b/browser/base/content/aboutDialog.css
index 017125bc2510..b3812605e875 100644
--- a/browser/base/content/aboutDialog.css
+++ b/browser/base/content/aboutDialog.css
@@ -81,6 +81,13 @@
   }
 }
 
+#denbrowserBuild {
+  opacity: 0.7;
+  user-select: text;
+  -moz-user-focus: normal;
+  cursor: text;
+}
+
 #distribution,
 #distributionId {
   display: none;
diff --git a/browser/base/content/aboutDialog.js b/browser/base/content/aboutDialog.js
index f6e1391baf12..64d85ba9eecd 100644
--- a/browser/base/content/aboutDialog.js
+++ b/browser/base/content/aboutDialog.js
@@ -18,6 +18,14 @@ if (AppConstants.MOZ_UPDATER) {
   );
 }
 
+// ── DEN: BUILD_COMMIT ──
+// GENERATED by build.sh (Step 2.8) from `git rev-parse --short HEAD` in the
+// DenBrowser repo. Do not edit here — it is rewritten on every build.
+// Empty when the build did not come from a git checkout; the About dialog
+// then omits the build id entirely.
+const DEN_BUILD_COMMIT = "";
+// ── DEN END: BUILD_COMMIT ──
+
 function init() {
   let defaults = Services.prefs.getDefaultBranch(null);
   let distroId = defaults.getCharPref("distribution.id", "");
@@ -85,6 +93,17 @@ function init() {
     versionAttributes
   );
 
+  // Stamp the DenBrowser commit this build was produced from next to the
+  // version, so a running browser can be tied back to an exact patch set.
+  let buildField = document.getElementById("denbrowserBuild");
+  if (DEN_BUILD_COMMIT) {
+    document.l10n.setAttributes(buildField, "about-denbrowser-build", {
+      commit: DEN_BUILD_COMMIT,
+    });
+  } else {
+    buildField.hidden = true;
+  }
+
   // Show a release notes link if we have a URL.
   let relNotesLink = document.getElementById("releasenotes");
   let relNotesPrefType = Services.prefs.getPrefType(
diff --git a/browser/base/content/aboutDialog.xhtml b/browser/base/content/aboutDialog.xhtml
index 3ffd464b960a..f8ee1580daab 100644
--- a/browser/base/content/aboutDialog.xhtml
+++ b/browser/base/content/aboutDialog.xhtml
@@ -14,7 +14,7 @@
         data-l10n-id="aboutDialog-title"
 #endif
         role="dialog"
-        aria-describedby="version distribution distributionId communityDesc contributeDesc trademark"
+        aria-describedby="version denbrowserBuild distribution distributionId communityDesc trademark"
         >
 #ifdef XP_MACOSX
 #include macWindow.inc.xhtml
@@ -49,6 +49,7 @@
         <!-- This HBOX is duplicated below with class="update" -->
         <hbox align="baseline">
           <label id="version"/>
+          <label id="denbrowserBuild"/>
           <label id="releasenotes" is="text-link" hidden="true" data-l10n-id="releaseNotes-link"/>
         </hbox>
 #endif
@@ -100,6 +101,7 @@
               <!-- This HBOX is duplicated above without class="update" -->
               <hbox align="baseline">
                 <label id="version" class="update"/>
+                <label id="denbrowserBuild"/>
                 <label id="releasenotes" is="text-link" hidden="true" data-l10n-id="releaseNotes-link"/>
               </hbox>
               <description class="text-blurb">
@@ -124,13 +126,8 @@
               <label is="text-link" useoriginprincipal="true" href="about:credits" data-l10n-name="community-exp-creditsLink"/>
             </description>
           </vbox>
-          <description class="text-blurb" id="communityDesc" data-l10n-id="community-2">
-            <label is="text-link" href="https://www.mozilla.org/?utm_source=firefox-browser&#38;utm_medium=firefox-desktop&#38;utm_campaign=about-dialog" data-l10n-name="community-mozillaLink"/>
-            <label is="text-link" useoriginprincipal="true" href="about:credits" data-l10n-name="community-creditsLink"/>
-          </description>
-          <description class="text-blurb" id="contributeDesc" data-l10n-id="helpus">
-            <label is="text-link" href="https://foundation.mozilla.org/?form=firefox-about" data-l10n-name="helpus-donateLink"/>
-            <label is="text-link" href="https://www.mozilla.org/contribute/?utm_source=firefox-browser&#38;utm_medium=firefox-desktop&#38;utm_campaign=about-dialog" data-l10n-name="helpus-getInvolvedLink"/>
+          <description class="text-blurb" id="communityDesc" data-l10n-id="about-denbrowser-description">
+            <label is="text-link" href="https://github.com/EhhChris/DenBrowser" data-l10n-name="github-link"/>
           </description>
         </vbox>
       </vbox>
@@ -142,6 +139,10 @@
         <label is="text-link" class="bottom-link" href="https://www.mozilla.org/privacy/firefox/?utm_source=firefox-browser&#38;utm_medium=firefox-desktop&#38;utm_campaign=about-dialog" data-l10n-id="bottom-links-privacy"/>
       </hbox>
       <description id="trademark" data-l10n-id="trademarkInfo"></description>
+      <hbox pack="end">
+        <label id="denbrowserCredit"
+               tooltiptext="DenBrowser developed by Chill">&#129398;</label>
+      </hbox>
     </vbox>
   </html:div>
 
diff --git a/browser/branding/denbrowser/locales/en-US/brand.ftl b/browser/branding/denbrowser/locales/en-US/brand.ftl
index bbfde3da7143..ec64766324ef 100644
--- a/browser/branding/denbrowser/locales/en-US/brand.ftl
+++ b/browser/branding/denbrowser/locales/en-US/brand.ftl
@@ -12,3 +12,17 @@
 -brand-product-name = DenBrowser
 -vendor-short-name = DenBrowser
 trademarkInfo = { " " }
+
+## About dialog
+# Shown in the About { -brand-short-name } dialog. The github-link label is
+# overlaid onto the <label data-l10n-name="github-link"> element in
+# aboutDialog.xhtml, which supplies the href.
+about-denbrowser-description = { -brand-short-name } is a hardened web browser built on Mozilla Firefox and distributed under the same Mozilla Public License. View the source code and patches on <label data-l10n-name="github-link">GitHub</label>.
+
+# Shown immediately to the right of the version in the About
+# { -brand-short-name } dialog, e.g. "153.0esr (64-bit) (build a1b2c3d)".
+# Variables:
+#   $commit (String): abbreviated DenBrowser repository commit this build was
+#     produced from, with a "-dirty" suffix when the tree carried uncommitted
+#     changes at build time. Injected into aboutDialog.js by build.sh.
+about-denbrowser-build = (build { $commit })
