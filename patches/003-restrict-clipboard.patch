index ff0badb..9c4fa4e 100644
--- a/dom/base/nsCopySupport.cpp
+++ b/dom/base/nsCopySupport.cpp
@@ -60,6 +60,7 @@
 #include "mozilla/IntegerRange.h"
 #include "mozilla/dom/Element.h"
 #include "mozilla/dom/HTMLInputElement.h"
