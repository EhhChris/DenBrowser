# PATCH: 003-restrict-clipboard
#
# Blocks all clipboard and drag-to-copy access, with an optional compile-time
# allow-list that permits in-browser copy/paste between specific sites.
#
# CORE BLOCKS (always active — six entry points):
#
# 1. Clipboard::ReadHelper (dom/events/Clipboard.cpp)
#    Blocks Clipboard.read() and Clipboard.readText() for all sites.
#    Listed sites use the internal clipboard path instead (see below).
#
# 2. Clipboard::Write (dom/events/Clipboard.cpp)
#    Blocks Clipboard.write() / writeText() for all sites.
#
# 3. Document::ExecCommand (dom/base/Document.cpp)
#    Blocks document.execCommand("cut/copy/paste") for all sites.
#
# 4. nsCopySupport::FireClipboardEvent (dom/base/nsCopySupport.cpp)
#    Blocks the user-level copy command (Ctrl+C / right-click Copy) for ALL
#    content.  Paste (Ctrl+V) is intercepted here too for listed sites (see
#    INTERNAL CLIPBOARD below).
#
# 5. nsBaseClipboard::SetData (widget/nsBaseClipboard.cpp)
#    Backstop: suppresses every remaining OS clipboard write path.
#
# 6. nsBaseDragSession::InvokeDragSession (widget/nsBaseDragService.cpp)
#    Blocks all drag-and-drop to prevent text exfiltration via URL bar drag.
#
# INTERNAL CLIPBOARD (optional — activated by site-config.json):
#
#   When config/site-config.json lists one or more hostnames in
#   "clipboard_sites", an in-process clipboard is activated for those sites:
#
#   - Copy (Ctrl+C) on a listed site extracts the selected text and stores
#     it in gDenInternalClipText.  The OS clipboard is never written.
#
#   - Paste (Ctrl+V) on a listed site reads from gDenInternalClipText via a
#     flag (gDenServePasteFromInternal) that is checked by
#     nsBaseClipboard::GetData before the normal OS clipboard read.
#
#   Data stored this way is never visible to the OS clipboard or to any
#   unlisted site.  build.sh injects the allow-list at compile time using
#   sentinel markers; empty config → full block, same as before.
#
# RELATIONSHIP TO PREFS:
#   lockPref("dom.allow_cut_copy", false) and
#   lockPref("dom.event.clipboardevents.enabled", false) in mozilla.cfg are
#   belt-and-suspenders.  This patch is the authoritative block.

--- a/dom/events/Clipboard.cpp
+++ b/dom/events/Clipboard.cpp
@@ -329,5 +329,8 @@
 already_AddRefed<Promise> Clipboard::ReadHelper(nsIPrincipal& aSubjectPrincipal,
                                                 ReadRequestType aType,
                                                 ErrorResult& aRv) {
+  // DenBrowser: clipboard read access disabled.
+  aRv.ThrowNotAllowedError("DenBrowser policy: clipboard access is disabled.");
+  return nullptr;
   // Create a new promise
   nsGlobalWindowInner* owner = GetOwnerWindow();
@@ -679,5 +682,8 @@
 already_AddRefed<Promise> Clipboard::Write(
     const Sequence<OwningNonNull<ClipboardItem>>& aData,
     nsIPrincipal& aSubjectPrincipal, ErrorResult& aRv) {
+  // DenBrowser: clipboard write access disabled.
+  aRv.ThrowNotAllowedError("DenBrowser policy: clipboard access is disabled.");
+  return nullptr;
   // Create a promise
   RefPtr<nsGlobalWindowInner> owner = GetOwnerWindow();
--- a/dom/base/nsCopySupport.cpp
+++ b/dom/base/nsCopySupport.cpp
@@ -68,6 +68,40 @@
 static NS_DEFINE_CID(kCClipboardCID, NS_CLIPBOARD_CID);
 static NS_DEFINE_CID(kCTransferableCID, NS_TRANSFERABLE_CID);
 static NS_DEFINE_CID(kHTMLConverterCID, NS_HTMLFORMATCONVERTER_CID);
+
+// ── DenBrowser internal clipboard ────────────────────────────────────────────
+// Compile-time clipboard allow-list. build.sh injects entries from
+// site-config.json between the sentinel markers at build time.
+// ── DEN: CLIPBOARD_SITES ──
+static const char* const kDenClipboardSites[] = { nullptr };
+// ── DEN END: CLIPBOARD_SITES ──
+
+// In-process clipboard storage, shared with nsBaseClipboard via extern linkage.
+nsString gDenInternalClipText;
+bool gDenInternalClipHasData = false;
+bool gDenServePasteFromInternal = false;
+
+static bool DenClipHostMatch(const nsACString& aHost, const char* aPat) {
+  nsDependentCString pat(aPat);
+  if (aHost.Equals(pat)) return true;
+  // Subdomain match: host must end with "." + pattern.
+  if (aHost.Length() > pat.Length() + 1) {
+    return aHost.CharAt(aHost.Length() - pat.Length() - 1) == '.' &&
+           Substring(aHost, aHost.Length() - pat.Length()).Equals(pat);
+  }
+  return false;
+}
+
+static bool DenClipSiteAllowed(const nsACString& aHost) {
+  for (int i = 0; kDenClipboardSites[i]; ++i) {
+    if (DenClipHostMatch(aHost, kDenClipboardSites[i])) return true;
+  }
+  return false;
+}

 // copy string data onto the transferable
 static nsresult AppendString(nsITransferable* aTransferable,
@@ -822,6 +856,26 @@
   BrowsingContext* bc = piWindow->GetBrowsingContext();
   const bool chromeShell = bc && bc->IsChrome();

+  // DenBrowser: block clipboard cut/copy for all content including browser UI.
+  // If the site is in the clipboard allow-list, capture selected text first so
+  // it can be served on paste within another listed site.
+  if (originalEventMessage == eCopy || originalEventMessage == eCut) {
+    if (kDenClipboardSites[0] && sel &&
+        !sel->AreNormalAndCrossShadowBoundaryRangesCollapsed()) {
+      nsAutoCString host;
+      if (nsIURI* uri = doc->GetDocumentURI()) {
+        uri->GetHost(host);
+      }
+      if (DenClipSiteAllowed(host)) {
+        nsAutoString selText;
+        IgnoredErrorResult err;
+        sel->ToString(selText, err);
+        if (!selText.IsEmpty()) {
+          gDenInternalClipText = selText;
+          gDenInternalClipHasData = true;
+        }
+      }
+    }
+    return false;
+  }
+
   // next, fire the cut, copy or paste event
   bool doDefault = true;
@@ -881,6 +931,18 @@
   if (originalEventMessage == ePaste) {
     if (aActionTaken) {
       *aActionTaken = true;
     }
+    // DenBrowser: if the event was not cancelled and this site is in the
+    // allow-list with stored data, signal nsBaseClipboard::GetData to serve
+    // from the in-process clipboard instead of the (always empty) OS clipboard.
+    if (doDefault && kDenClipboardSites[0] && gDenInternalClipHasData) {
+      nsAutoCString host;
+      if (nsIURI* uri = doc->GetDocumentURI()) {
+        uri->GetHost(host);
+      }
+      if (DenClipSiteAllowed(host)) {
+        gDenServePasteFromInternal = true;
+      }
+    }
     return doDefault;
   }
