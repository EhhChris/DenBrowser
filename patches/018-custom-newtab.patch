diff --git a/browser/base/content/denbrowser-newtab.css b/browser/base/content/denbrowser-newtab.css
new file mode 100644
index 0000000000..3ddc34fb45
--- /dev/null
+++ b/browser/base/content/denbrowser-newtab.css
@@ -0,0 +1,108 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* Styles for the DenBrowser custom new-tab page (about:denbrowserhome).
+ * Loaded as chrome://browser/content/denbrowser-newtab.css — see patch 018. */
+
+:root {
+  --den-bg: #f9f9fb;
+  --den-fg: #15141a;
+  --den-tile-bg: #ffffff;
+  --den-tile-border: #cfcfd8;
+  --den-accent: #0060df;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --den-bg: #1c1b22;
+    --den-fg: #fbfbfe;
+    --den-tile-bg: #2b2a33;
+    --den-tile-border: #52525e;
+    --den-accent: #00ddff;
+  }
+}
+
+* {
+  box-sizing: border-box;
+}
+
+html,
+body {
+  margin: 0;
+  height: 100%;
+  background: var(--den-bg);
+  color: var(--den-fg);
+  font: menu;
+  font-size: 15px;
+}
+
+.den-newtab {
+  min-height: 100%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 48px 24px;
+}
+
+.den-tiles {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(140px, 160px));
+  gap: 20px;
+  justify-content: center;
+  max-width: 960px;
+}
+
+.den-tile {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 12px;
+  padding: 20px 12px;
+  border: 1px solid var(--den-tile-border);
+  border-radius: 12px;
+  background: var(--den-tile-bg);
+  color: inherit;
+  text-decoration: none;
+  transition:
+    border-color 0.15s,
+    transform 0.15s;
+}
+
+.den-tile:hover {
+  border-color: var(--den-accent);
+  transform: translateY(-2px);
+}
+
+.den-tile:focus-visible {
+  outline: 2px solid var(--den-accent);
+  outline-offset: 2px;
+}
+
+.den-badge {
+  width: 48px;
+  height: 48px;
+  border-radius: 50%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: var(--den-accent);
+  color: #fff;
+  font-size: 22px;
+  font-weight: 600;
+  text-transform: uppercase;
+}
+
+.den-label {
+  max-width: 100%;
+  font-size: 14px;
+  font-weight: 500;
+  text-align: center;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.den-empty {
+  opacity: 0.6;
+}
diff --git a/browser/base/content/denbrowser-newtab.html b/browser/base/content/denbrowser-newtab.html
new file mode 100644
index 0000000000..9c3b364c85
--- /dev/null
+++ b/browser/base/content/denbrowser-newtab.html
@@ -0,0 +1,39 @@
+<!doctype html>
+
+<!-- This Source Code Form is subject to the terms of the Mozilla Public
+   - License, v. 2.0. If a copy of the MPL was not distributed with this
+   - file, You can obtain one at http://mozilla.org/MPL/2.0/. -->
+
+<!-- DenBrowser custom new-tab page. Served for about:denbrowserhome by the C++
+   - AboutRedirector (see patch 018), the same mechanism that renders about:robots
+   - and about:privatebrowsing. New tabs are pointed here because the stock
+   - activity-stream new-tab page never initializes in this hardened,
+   - permanent-private-browsing build. The shortcut tiles between the
+   - DEN_SHORTCUTS markers are generated at build time by build.sh from
+   - config/site-config.json's "bookmarks" list — do not edit them by hand. -->
+
+<html xmlns="http://www.w3.org/1999/xhtml">
+  <head>
+    <meta charset="utf-8" />
+    <meta
+      http-equiv="Content-Security-Policy"
+      content="default-src chrome:; object-src 'none';"
+    />
+    <meta name="color-scheme" content="light dark" />
+    <title>New Tab</title>
+    <link
+      rel="stylesheet"
+      href="chrome://browser/content/denbrowser-newtab.css"
+      media="all"
+    />
+  </head>
+  <body>
+    <main class="den-newtab">
+      <nav class="den-tiles" aria-label="Shortcuts">
+        <!-- DEN_SHORTCUTS_START -->
+        <p class="den-empty">No shortcuts configured.</p>
+        <!-- DEN_SHORTCUTS_END -->
+      </nav>
+    </main>
+  </body>
+</html>
