# PATCH: 025-disable-audio
#
# Disables audio output originating from web content. The requirement is that
# playback be silent but otherwise indistinguishable from normal playback --
# play() resolves, timeupdate/ended fire, currentTime advances, AudioContext
# keeps running -- so that sites which gate their UI on playback succeeding
# keep working.
#
# Two enforcement layers:
#
# 1. Window level -- nsPIDOMWindowOuter::GetAudioMuted (dom/base/nsGlobalWindowOuter.cpp)
#    THE PRIMARY GATE. Every window reports as muted. AudioChannelService hands
#    this to every audio agent, both at registration (AudioChannelService.cpp,
#    `config.mMuted = config.mMuted || window->GetAudioMuted()`) and on refresh,
#    so it covers elements that begin playing later as well as those already
#    playing. Media elements take MUTED_BY_AUDIO_CHANNEL, ComputedVolume()
#    becomes 0, and AudioSinkWrapper::NeedAudioSink() -- `!IsMuted() && ...`,
#    where IsMuted() is `mParams.mVolume == 0.0` -- goes false, so the AudioSink
#    is torn down and no cubeb stream is ever opened. Web Audio is covered by
#    the same callback via AudioDestinationNode::WindowVolumeChanged.
#
#    Muting here rather than silencing further downstream is deliberate, for
#    two reasons:
#
#      - No tab sound indicator. AudibilityMonitor measures *decoded samples*
#        inside AudioSink (AudioSink::CheckIsAudible), which is upstream of
#        cubeb's gain. Anything that silences at or below cubeb leaves the
#        speaker icon lit on a tab that emits no sound. With no AudioSink there
#        is no audibility event, so the icon never appears.
#      - No page-visible error. Failing stream creation instead would surface
#        through AudioSinkWrapper -> MediaDecoderStateMachine::OnMediaSinkAudioError,
#        which returns early only `if (HasVideo())`; audio-only media would
#        raise DecodeError and fire an error event at the element.
#
#    The check short-circuits before GetMuted(), so un-muting a tab -- from the
#    tab context menu, or from content via the replicated BrowsingContext field,
#    which has no CanSet override -- cannot re-enable output.
#
# 2. cubeb gain -- CubebUtils::GetVolumeScale (dom/media/CubebUtils.cpp)
#    Backstop for any output stream created despite layer 1; every cubeb output
#    stream multiplies its gain through this value. Checked before taking
#    sMutex, since this sits on the stream-init path.
#
# Both layers read denbrowser::AudioOutputAllowed() from the new header
# dom/media/DenBrowserAudioGate.h, a constexpr false. It is a function rather
# than a bare constant so that a future conditional policy is a change to that
# predicate alone, leaving these enforcement points untouched.
#
# Not patched, deliberately:
#
# - Chrome event sounds (widget/*/nsSound.*). ::PlaySoundW and ::MessageBeep
#   reach the speakers through winmm rather than cubeb, so the layers above do
#   not cover them -- but every caller is chrome-initiated or requires a direct
#   user gesture on browser UI, so none is a content-driven audio path:
#     * alert()/confirm()/prompt() are the only content-reachable dialogs, and
#       Firefox already suppresses their sound upstream: PromptParent sets
#       args.openedWithTabDialog = true for content prompts, and CommonDialog
#       plays a sound only `if (this.soundID && !this.args.openedWithTabDialog)`.
#     * EVENT_MENU_POPUP (nsMenuPopupFrame) fires for XUL menus, which content
#       cannot open without a user gesture on browser chrome.
#     * The find-bar cues (FinderSound), the clipboard-menu beep, the downloads
#       beep and selectDialog are all chrome-initiated.
#   Leaving these audible is also the accessible choice: the find-bar cues are
#   gated by accessibility.typeaheadfind.enablesound and are non-visual feedback
#   that a search failed. Silencing them would remove a signal for low-vision
#   users while closing no content-reachable path.
#
#   Consequence to be explicit about: DenBrowser can still emit chrome event
#   sounds. This patch blocks audio from *web content*, not every sound the
#   application can make.
#
# - cubeb stream creation (CubebUtils::CubebStreamInit). Rejecting there would
#   produce the audio-only DecodeError described above. The lockPref
#   media.cubeb.force_null_context in config/mozilla.cfg is the hard backstop
#   instead: it is the first check in GetCubebUnlocked(), so no cubeb context
#   exists at all. It is unreachable in normal operation because layer 1
#   prevents the sink from ever being requested.
#
# - Windows SAPI text-to-speech (dom/media/webspeech/synth/windows/SapiService.cpp)
#   drives OS audio directly and is covered by none of the above. It is held
#   shut by lockPref media.webspeech.synth.enabled, compiled into libxul by
#   patch 017. Closing it in source would mean a SapiService hard-reject in the
#   style of patch 002; out of scope here, recorded so it is not mistaken for
#   an oversight.
#
# - The WMF Media Engine (dom/media/ipc/MFMediaEngineParent.cpp) renders audio
#   itself via MF_MEDIA_ENGINE_AUDIO_CATEGORY and never touches cubeb. It is
#   shut off by lockPref media.wmf.media-engine.enabled = 0.
#
# - The about:support latency probe (CubebUtils.cpp) creates its own cubeb
#   output stream outside CubebStreamInit, but its callback already PodZero's
#   the output buffer, and about:support is blocked by policy.
#
# - The tab mute button and its context-menu item are left in place. They only
#   surface when a tab is soundplaying or muted, and layer 1 means neither
#   state is ever reached, so hiding them would add ESR-rebase surface for no
#   user-visible difference.


diff --git a/dom/base/nsGlobalWindowOuter.cpp b/dom/base/nsGlobalWindowOuter.cpp
index dd07395..2a76b71 100644
--- a/dom/base/nsGlobalWindowOuter.cpp
+++ b/dom/base/nsGlobalWindowOuter.cpp
@@ -12,6 +12,7 @@
 #include "nsGlobalWindowInner.h"
 
 // Local Includes
+#include "DenBrowserAudioGate.h"
 #include "Navigator.h"
 #include "WindowDestroyedEvent.h"
 #include "WindowNamedPropertiesHandler.h"
@@ -3057,6 +3058,16 @@ void nsPIDOMWindowOuter::NotifyResumingDelayedMedia() {
 }
 
 bool nsPIDOMWindowOuter::GetAudioMuted() const {
+  // DenBrowser: audio output is disabled. Reporting every window as muted is
+  // what keeps playback silent *and* indistinguishable from normal playback:
+  // AudioChannelService hands this to every audio agent, so no AudioSink and
+  // therefore no cubeb stream is ever created, while the media element's
+  // lifecycle (timeupdate, ended, currentTime) is untouched and no error is
+  // raised. It also short-circuits before GetMuted(), so a page or a chrome
+  // caller un-muting the tab cannot re-enable output.
+  if (!denbrowser::AudioOutputAllowed()) {
+    return true;
+  }
   BrowsingContext* bc = GetBrowsingContext();
   return bc && bc->Top()->GetMuted();
 }
diff --git a/dom/media/CubebUtils.cpp b/dom/media/CubebUtils.cpp
index 637c7be..15673c5 100644
--- a/dom/media/CubebUtils.cpp
+++ b/dom/media/CubebUtils.cpp
@@ -43,6 +43,7 @@
 
 #include "CallbackThreadRegistry.h"
 #include "CubebDeviceEnumerator.h"
+#include "DenBrowserAudioGate.h"
 #include "audioipc2_client_ffi_generated.h"
 #include "audioipc2_server_ffi_generated.h"
 #include "mozilla/StaticPrefs_media.h"
@@ -417,6 +418,13 @@ bool GetFirstStream() {
 }
 
 double GetVolumeScale() {
+  // DenBrowser: backstop for any output stream that is created despite the
+  // window-level gate in nsPIDOMWindowOuter::GetAudioMuted() — every cubeb
+  // output stream multiplies its gain through this value. Checked before
+  // taking sMutex because this is on the stream-init path.
+  if (!denbrowser::AudioOutputAllowed()) {
+    return 0.0;
+  }
   StaticMutexAutoLock lock(sMutex);
   return sVolumeScale;
 }
diff --git a/dom/media/DenBrowserAudioGate.h b/dom/media/DenBrowserAudioGate.h
new file mode 100644
index 0000000..24b24cc
--- /dev/null
+++ b/dom/media/DenBrowserAudioGate.h
@@ -0,0 +1,22 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+#ifndef DenBrowserAudioGate_h__
+#define DenBrowserAudioGate_h__
+
+namespace denbrowser {
+
+// Compile-time audio-output policy. Audio playback is disabled outright, so
+// this is a constant rather than a pref: there is no runtime state a profile,
+// an extension, or a compromised content process could flip.
+//
+// Callers must go through AudioOutputAllowed() rather than testing the
+// constant, so that the enforcement points below stay untouched if a future
+// deployment needs a conditional policy (e.g. output permitted only for a
+// particular device class) — that becomes a change of this predicate alone.
+inline constexpr bool AudioOutputAllowed() { return false; }
+
+}  // namespace denbrowser
+
+#endif  // DenBrowserAudioGate_h__
