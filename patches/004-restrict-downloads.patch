# PATCH: 004-restrict-downloads
#
# Blocks file-save and download paths at five enforcement points:
#
# 1. saveBrowser() (toolkit/content/contentAreaUtils.js)
#    Stops browser and PDF.js page saves before WebBrowserPersist starts.
#
# 2. internalSave() (toolkit/content/contentAreaUtils.js)
#    Backstops Save Page/Link/Image As, Alt-click saves, and other callers that
#    bypass saveBrowser(). It mirrors picker-cancel cleanup without opening a
#    picker or retaining a closing persist document.
#
# 3. nsExternalHelperAppService::CreateListener (uriloader/exthandler/)
#    Cancels HTTP-triggered downloads before allocating a helper listener and
#    returns NS_ERROR_ABORT with a null out-parameter.
#
# 4. ShellService.canSetDesktopBackground (browser/components/shell/)
#    Suppresses the desktop-background command before it can invoke persistence.
#
# 5. nsMacShellService::SetDesktopBackground and
#    nsWindowsShellService::SetDesktopBackground
#    Abort at the native shell-service boundary as defense in depth.
#
# Shared feedback for patches 004 and 005 is asynchronous and non-modal.
# browser-init.js coalesces repeated save/print events into per-tab notification
# bars, re-arms a four-second lifetime, and reroutes short-lived popups to their
# opener, including a popup that closes before its queued notification runs.


diff --git a/browser/base/content/browser-init.js b/browser/base/content/browser-init.js
index 311e36a..beacf61 100644
--- a/browser/base/content/browser-init.js
+++ b/browser/base/content/browser-init.js
@@ -40,6 +40,162 @@ var gSerialDeviceObserver = {
   },
 };
 
+const DENBROWSER_BLOCKED_NOTIFICATION_TIMEOUT_MS = 4000;
+const DENBROWSER_BLOCKED_NOTIFICATION_DETAILS = new Map([
+  [
+    "DenBrowserSaveBlocked",
+    {
+      value: "denbrowser-saving-blocked",
+      l10nId: "denbrowser-saving-blocked-infobar",
+    },
+  ],
+  [
+    "DenBrowserPrintingBlocked",
+    {
+      value: "denbrowser-printing-blocked",
+      l10nId: "denbrowser-printing-blocked-infobar",
+    },
+  ],
+]);
+const gDenBrowserBlockedNotificationStates = new WeakMap();
+
+function clearDenBrowserBlockedNotificationState(browser, value, state) {
+  if (state.timer) {
+    window.clearTimeout(state.timer);
+  }
+  let browserStates = gDenBrowserBlockedNotificationStates.get(browser);
+  if (browserStates?.get(value) == state) {
+    browserStates.delete(value);
+  }
+}
+
+function armDenBrowserBlockedNotificationTimeout(
+  browser,
+  notificationBox,
+  details,
+  state
+) {
+  if (state.timer) {
+    window.clearTimeout(state.timer);
+  }
+  state.timer = window.setTimeout(() => {
+    if (state.notification?.isConnected) {
+      notificationBox.removeNotification(state.notification);
+    } else {
+      clearDenBrowserBlockedNotificationState(browser, details.value, state);
+    }
+  }, DENBROWSER_BLOCKED_NOTIFICATION_TIMEOUT_MS);
+}
+
+async function showDenBrowserBlockedNotification(browser, details) {
+  let notificationBox = browser.getTabBrowser?.()?.getNotificationBox(browser);
+  if (!notificationBox) {
+    return;
+  }
+
+  let browserStates = gDenBrowserBlockedNotificationStates.get(browser);
+  if (!browserStates) {
+    browserStates = new Map();
+    gDenBrowserBlockedNotificationStates.set(browser, browserStates);
+  }
+
+  let state = browserStates.get(details.value);
+  if (state) {
+    if (state.notification?.isConnected) {
+      armDenBrowserBlockedNotificationTimeout(
+        browser,
+        notificationBox,
+        details,
+        state
+      );
+    }
+    return;
+  }
+
+  state = { notification: null, timer: null };
+  browserStates.set(details.value, state);
+
+  try {
+    let existing = notificationBox.getNotificationWithValue(details.value);
+    state.notification =
+      existing ||
+      (await notificationBox.appendNotification(details.value, {
+        label: { "l10n-id": details.l10nId },
+        priority: notificationBox.PRIORITY_INFO_LOW,
+        eventCallback: event => {
+          if (
+            event == "dismissed" ||
+            event == "removed" ||
+            event == "disconnected"
+          ) {
+            clearDenBrowserBlockedNotificationState(
+              browser,
+              details.value,
+              state
+            );
+          }
+        },
+      }));
+
+    if (!state.notification?.isConnected) {
+      clearDenBrowserBlockedNotificationState(browser, details.value, state);
+      return;
+    }
+
+    armDenBrowserBlockedNotificationTimeout(
+      browser,
+      notificationBox,
+      details,
+      state
+    );
+  } catch {
+    // The tab or window may have closed while the notification was being made.
+    clearDenBrowserBlockedNotificationState(browser, details.value, state);
+  }
+}
+
+function queueDenBrowserBlockedNotification(event) {
+  let eventType = event.type;
+  let details = DENBROWSER_BLOCKED_NOTIFICATION_DETAILS.get(eventType);
+  let browser = event.target;
+  if (!details || browser?.localName != "browser") {
+    return;
+  }
+
+  // Short-lived chromeless popups commonly close as soon as print() returns.
+  // Put their notification on the opener so that it remains visible.
+  let openerBrowser = browser.browsingContext?.opener?.top?.embedderElement;
+  let chromeDocument = browser.documentGlobal?.document?.documentElement;
+  if (
+    openerBrowser &&
+    chromeDocument?.getAttribute("chromehidden") &&
+    !browser.canGoBack
+  ) {
+    let openerWindow = openerBrowser.documentGlobal;
+    openerBrowser.dispatchEvent(
+      new openerWindow.CustomEvent(eventType, { bubbles: true })
+    );
+    return;
+  }
+
+  // Keep the opener's chrome window alive as the timer host. If a regular
+  // popup closes before this callback runs, route the notification to its
+  // opener instead of losing it with the popup.
+  let timerWindow = openerBrowser?.documentGlobal || window;
+  timerWindow.setTimeout(() => {
+    if (!browser.isConnected && openerBrowser?.isConnected) {
+      let openerWindow = openerBrowser.documentGlobal;
+      openerBrowser.dispatchEvent(
+        new openerWindow.CustomEvent(eventType, { bubbles: true })
+      );
+      return;
+    }
+    if (browser.isConnected) {
+      void showDenBrowserBlockedNotification(browser, details);
+    }
+  }, 0);
+}
+
 let _resolveDelayedStartup;
 var delayedStartupPromise = new Promise(resolve => {
   _resolveDelayedStartup = resolve;
@@ -309,6 +465,15 @@ var gBrowserInit = {
   },
 
   onLoad() {
+    document.addEventListener(
+      "DenBrowserSaveBlocked",
+      queueDenBrowserBlockedNotification
+    );
+    document.addEventListener(
+      "DenBrowserPrintingBlocked",
+      queueDenBrowserBlockedNotification
+    );
+
     gBrowser.addEventListener("DOMUpdateBlockedPopups", e =>
       PopupAndRedirectBlockerObserver.handleEvent(e)
     );
