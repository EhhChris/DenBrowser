FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        python3 \
        python3-cryptography \
        python3-requests \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10002 testclient \
    && useradd --system --uid 10002 --gid testclient --no-create-home testclient

COPY --chmod=0555 attestation/test_roundtrip.py /usr/local/bin/test_roundtrip.py
COPY --chmod=0555 minimal-proxy-stack/run-client.sh /usr/local/bin/run-client.sh

USER testclient
ENTRYPOINT ["/usr/local/bin/run-client.sh"]
